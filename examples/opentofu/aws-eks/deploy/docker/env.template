# mandatory values:
INSTANCE_NAME= # lowercase letters, digits and hyphens, the cluster and database are named after it
TF_VAR_region=eu-central-1

# credentials: leave them out on an EC2 instance with an instance profile (IMDSv2 hop limit 2)
# AWS_ACCESS_KEY_ID={{ .Secrets.AWS_ACCESS_KEY_ID }}
# AWS_SECRET_ACCESS_KEY={{ .Secrets.AWS_SECRET_ACCESS_KEY }}

# optional values:
APPLY_MODE=plan # plan only logs the changes for a review, auto applies every plan, DESTROY_CONFIRM destroys in both
RECONCILE_INTERVAL=15m
# PROVIDER_MIRROR= # installs the providers from OCI repositories below this prefix instead of registry.opentofu.org
# REGISTRY_USERNAME= # credentials for the registries of the module and the provider mirror
# REGISTRY_PASSWORD=
STATE_ENCRYPTION_PASSPHRASE={{ .Secrets.STATE_ENCRYPTION_PASSPHRASE }} # at least 16 characters
# TF_VAR_kubernetes_version=1.35
# TF_VAR_node_count=2
# TF_VAR_database_deletion_protection=false # required before destroying
# TF_VAR_bucket_force_destroy=true # required before destroying, deletes the objects in the bucket
# DESTROY_CONFIRM= # set to INSTANCE_NAME to destroy the installation
