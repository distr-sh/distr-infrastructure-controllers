# mandatory values:
INSTANCE_NAME= # lowercase letters, digits and hyphens

# optional values:
APPLY_MODE=auto # auto applies every plan, plan only logs it for review
RECONCILE_INTERVAL=15m
# PROVIDER_MIRROR= # installs the providers from OCI repositories below this prefix instead of registry.opentofu.org
# REGISTRY_USERNAME= # credentials for the registries of the module and the provider mirror
# REGISTRY_PASSWORD=
STATE_ENCRYPTION_PASSPHRASE={{ .Secrets.STATE_ENCRYPTION_PASSPHRASE }} # at least 16 characters
# TF_VAR_greeting=Hello from Distr BYOC
# TF_VAR_provisioning_duration=45s # how long the fake provisioning takes
# DESTROY_CONFIRM= # set to INSTANCE_NAME to destroy the infrastructure
