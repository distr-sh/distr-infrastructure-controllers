# mandatory values:
INSTANCE_NAME= # lowercase letters, digits and hyphens, the resource group and storage account are named after it
ARM_SUBSCRIPTION_ID=
TF_VAR_location=westeurope

# credentials: the managed identity of the VM running the Distr Docker controller, or a service principal
ARM_USE_MSI=true
# ARM_TENANT_ID=
# ARM_CLIENT_ID=
# ARM_CLIENT_SECRET={{ .Secrets.ARM_CLIENT_SECRET }}

# optional values:
APPLY_MODE=auto # auto applies every plan, plan only logs it for review
RECONCILE_INTERVAL=15m
# PROVIDER_MIRROR= # installs the providers from OCI repositories below this prefix instead of registry.opentofu.org
# REGISTRY_USERNAME= # credentials for the registries of the module and the provider mirror
# REGISTRY_PASSWORD=
STATE_ENCRYPTION_PASSPHRASE={{ .Secrets.STATE_ENCRYPTION_PASSPHRASE }} # at least 16 characters
# TF_VAR_title=Hello from Distr BYOC
# DESTROY_CONFIRM= # set to INSTANCE_NAME to destroy the website
